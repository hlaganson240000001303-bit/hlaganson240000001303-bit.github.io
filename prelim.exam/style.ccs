/* ===== Reset ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    background: #050b18;
    color: #ffffff;
    line-height: 1.6;
}

/* ===== Header ===== */
.main-header {
    background: #081426;
    padding: 20px 10%;
    border-bottom: 2px solid #00aaff;
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    text-decoration: none;
    font-size: 30px;
    font-weight: bold;
    color: white;
}

.highlight {
    color: #00aaff;
}

.nav-list {
    list-style: none;
    display: flex;
    gap: 30px;
}

.nav-link {
    text-decoration: none;
    color: white;
    font-size: 17px;
    transition: 0.3s;
}

.nav-link:hover,
.nav-link.active {
    color: #00aaff;
}


/* ===== Hero Section ===== */
.hero-section {
    padding: 100px 10%;
    text-align: center;
    background: linear-gradient(
        rgba(0,0,0,0.6),
        rgba(0,0,0,0.6)
    );
}

.hero-title {
    font-size: 50px;
    margin-bottom: 20px;
}

.highlight-text {
    color: #00aaff;
}

.hero-subtitle {
    max-width: 800px;
    margin: auto;
    color: #cccccc;
    font-size: 18px;
}


/* ===== Sections ===== */
.section-container {
    width: 85%;
    margin: auto;
}

.section-title {
    text-align: center;
    font-size: 35px;
    color: #00aaff;
    margin-bottom: 40px;
}


/* ===== Programs Cards ===== */
.programs-section {
    padding: 70px 0;
}

.programs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
    gap: 25px;
}

.program-card {
    background: #0d1b30;
    padding: 30px;
    border-radius: 15px;
    border: 1px solid #1c3555;
    transition: 0.3s;
}

.program-card:hover {
    transform: translateY(-10px);
    border-color: #00aaff;
    box-shadow: 0 0 20px #0077cc;
}

.card-title {
    color: #00aaff;
    margin-bottom: 15px;
}

.card-desc {
    color: #cccccc;
}


/* ===== Table ===== */
.table-section {
    padding: 70px 0;
}

.table-wrapper {
    overflow-x: auto;
}

.specs-table {
    width: 100%;
    border-collapse: collapse;
    background: #0d1b30;
}

.specs-table th {
    background: #00aaff;
    color: black;
    padding: 15px;
}

.specs-table td {
    padding: 15px;
    border: 1px solid #263b55;
    color: #ddd;
}

.specs-table tr:hover {
    background: #122642;
}

.bold-text {
    font-weight: bold;
    color: #00aaff;
}


/* ===== Form ===== */
.form-section {
    padding: 70px 0;
}

.form-wrapper {
    background: #0d1b30;
    padding: 40px;
    border-radius: 15px;
    max-width: 600px;
    margin: auto;
    border: 1px solid #1c3555;
}

.form-group {
    margin-bottom: 20px;
}

label {
    display: block;
    margin-bottom: 8px;
    color: #00aaff;
}

input,
select {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    border: none;
    outline: none;
    background: #06101f;
    color: white;
}


.btn {
    width: 100%;
    padding: 14px;
    background: #00aaff;
    border: none;
    border-radius: 25px;
    color: black;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.btn:hover {
    background: white;
}


/* ===== Footer ===== */
.main-footer {
    background: #081426;
    padding: 25px;
    text-align: center;
    border-top: 2px solid #00aaff;
}

.footer-container p {
    color: #aaa;
    font-size: 14px;
}


/* ===== Responsive ===== */
@media(max-width:768px){

    .header-container {
        flex-direction: column;
        gap: 20px;
    }

    .nav-list {
        flex-direction: column;
        text-align: center;
    }

    .hero-title {
        font-size: 35px;
    }

    .section-title {
        font-size: 28px;
    }
}
